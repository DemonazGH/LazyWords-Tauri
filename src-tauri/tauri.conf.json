{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tauri-app",
  "version": "0.1.0",
  "identifier": "com.dzmitry.tauri-app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "icons/icon.png": "icons/icon.png",
      "../src/dictionaries/en-ru.csv": "dictionaries/en-ru.csv",
      "../src/dictionaries/en-definitions.csv": "dictionaries/en-definitions.csv",
      "../src/dictionaries/en-irregular-verbs.csv": "dictionaries/en-irregular-verbs.csv",
      "../src/locales/en.json": "locales/en.json",
      "../src/locales/ru.json": "locales/ru.json"
    }
  }
}
